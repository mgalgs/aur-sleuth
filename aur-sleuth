def dry_run_enabled() -> bool:
    """Whether to build every prompt, count it, and answer it locally.

    What the loop sends is package-determined, not model-determined: the same
    files and the same bytes go out whichever model holds the seat (measured --
    two models on the same 12 packages differed by under 12% on prompt tokens,
    all of it tokenizer, none of it content). So the input side can be measured
    exactly, offline and for free; only accuracy needs a live model.
    """
    return os.environ.get("AUR_SLEUTH_DRY_RUN", "").lower() in ("1", "true", "yes")


def record_call(**row) -> None:
    """Append one call's accounting to the ledger. Called from audit threads."""
    with _CALL_LEDGER_LOCK:
        CALL_LEDGER.append(row)


def write_call_ledger(report_file: Path, package_name: str) -> Optional[Path]:
    """Write the ledger beside the report, when asked for.

    Off by default: the pipeline publishes what lands in its report directory,
    and this is measurement, not an audit artifact. AUR_SLEUTH_CALL_LEDGER is
    "1" for a sidecar next to the report, a path ending in .json for one file,
    or anything else for a directory that gets one file per package -- which is
    what a run over many packages needs, since one path would have each audit
    overwrite the last.
    """
    dest = os.environ.get("AUR_SLEUTH_CALL_LEDGER", "")
    if not dest or not CALL_LEDGER:
        return None
    if dest in ("1", "true", "yes"):
        path = report_file.parent / f"aur-sleuth-calls-{package_name}.json"
    elif dest.endswith(".json"):
        path = Path(dest)
    else:
        path = Path(dest) / f"{package_name}.json"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(
                {
                    "package": package_name,
                    "dry_run": dry_run_enabled(),
                    "calls": CALL_LEDGER,
                },
                indent=2,
            ),
            encoding="utf-8",
        )
    except OSError as e:
        logger.warning("Failed to write call ledger: %s", e)
        return None
    return path


def sanitize_for_llm(text: str) -> str:
    """
    Sanitize user input to prevent prompt injection attacks.
    Escapes special characters that could be used to manipulate LLM prompts.
    """
    # Include quotes for attribute safety
    return saxutils.escape(text, entities={'"': "&quot;", "'": "&apos;"})


class ModelPricingParams(NamedTuple):
    prompt: Decimal
    completion: Decimal
    request: Decimal
    image: Decimal
    audio: Decimal
    web_search: Decimal
    internal_reasoning: Decimal


class LLMClient:
    """A wrapper around OpenAI client that tracks token usage and costs."""

    def __init__(self, openai_client: Optional[OpenAI] = None):
        self.openai_client = openai_client
        # Other clients can be added here in the future
        if not any([self.openai_client]):
            raise ValueError("No LLM client configured.")
        self.prompt_tokens: Dict[str, int] = defaultdict(lambda: 0)
        self.completion_tokens: Dict[str, int] = defaultdict(lambda: 0)
        self.total_cost: Dict[str, Decimal] = defaultdict(lambda: Decimal("0"))
        # What actually answered, per the API's own response.model. A router
        # id like openrouter/free hides its author; this is where the real
        # one surfaces, and the report records it when it differs.
        self.served_models: set[str] = set()
        # Whether any model ever answered. A run where every call failed has
        # no model's word in it, and the report is withdrawn at exit.
        self.ok_calls = 0
        self.api_errors = 0
        # When a provider says its per-DAY allowance is spent, the epoch at
        # which it resets, from the 429's own headers. Reported at exit
        # (status 4) so the pipeline stops probing a dead cap until then.
        self.quota_reset_epoch: Optional[int] = None
        # Whether the "a 429 said nothing about a per-day cap" line has been
        # logged. Once per client: a spent tier answers every call that way,
        # and the point is to see the shape of one, not dozens.
        self.rate_limit_shape_logged = False
        self.pricing: Dict[str, ModelPricingParams] = dict()  # model => pricing
        self._fetch_pricing_info()

    def _fetch_pricing_info(self):
        """Fetch up-to-date pricing information.

        Pricing decides what every cost figure reports, and bench/pipeline.sh's
        --daily-budget is a sum of those figures. With no pricing every audit costs
        "0" and the budget can never bind, so the source is chosen explicitly:
        AUR_SLEUTH_PRICING=openrouter forces OpenRouter's price list, which is what
        a proxy in front of OpenRouter needs, since its base URL gives nothing away;
        "none" skips the lookup; unset means infer it from the base URL.
        """
        # A dry run never reaches _calculate_cost, so the price list would buy
        # nothing but a network round trip.
        if dry_run_enabled():
            return
        source = os.environ.get("AUR_SLEUTH_PRICING", "").strip().lower()
        if not source:
            base_url = str(getattr(self.openai_client, "base_url", ""))
            source = "openrouter" if "openrouter.ai" in base_url else "none"
        if source == "openrouter":
            try:
                self._fetch_openrouter_pricing()
            except requests.RequestException as e:
                logger.warning(
                    "Could not fetch OpenRouter pricing (%s); every cost will "
                    "report as 0 and a daily budget cannot bind", e,
                )
        elif source != "none":
            logger.warning("Unknown AUR_SLEUTH_PRICING=%r; costs will report as 0", source)

    def _fetch_openrouter_pricing(self):
        logger.debug("Fetching model pricing from OpenRouter API")
        response = requests.get("https://openrouter.ai/api/v1/models", timeout=10)
        if response.status_code == 200:
            models_data = response.json()
            for model_data in models_data.get("data", []):
                model_name = model_data.get("id")
                pricing = model_data.get("pricing", {})
                if not all([model_name, pricing]):
                    continue
                self.pricing[model_name] = ModelPricingParams(
                    prompt=Decimal(pricing.get("prompt", 0)),
                    completion=Decimal(pricing.get("completion", 0)),
                    request=Decimal(pricing.get("request", 0)),
                    image=Decimal(pricing.get("image", 0)),
                    audio=Decimal(pricing.get("audio", 0)),
                    web_search=Decimal(pricing.get("web_search", 0)),
                    internal_reasoning=Decimal(pricing.get("internal_reasoning", 0)),
                )

    def _calculate_cost(
        self, model_name: str, prompt_tokens: int, completion_tokens: int
    ) -> Decimal:
        """Calculate cost based on token usage and pricing info."""
        if model_name not in self.pricing:
            return Decimal("0")

        prompt_cost = prompt_tokens * self.pricing[model_name].prompt
        completion_cost = completion_tokens * self.pricing[model_name].completion
        return prompt_cost + completion_cost

    def chat_completions_create(self, *args, **kwargs):
        """Wrapper around client.chat.completions.create that tracks usage."""
        if self.openai_client:
            return self._openai_chat_completions_create(*args, **kwargs)
        raise ValueError("No LLM client configured.")

    def _openai_chat_completions_create(self, *args, **kwargs):
        if not self.openai_client:
            raise ValueError("OpenAI client not configured.")

        try:
            response = self.openai_client.chat.completions.create(*args, **kwargs)
        except APIError as e:
            self.api_errors += 1
            reset = quota_reset_from_error(e)
            if reset:
                self.quota_reset_epoch = max(self.quota_reset_epoch or 0, reset)
            elif getattr(e, "status_code", None) == 429 and not self.rate_limit_shape_logged:
                self.rate_limit_shape_logged = True
                logger.warning("a 429 said nothing about a per-day cap, so the daily-cap note stays unset: %s", rate_limit_shape(e))
            raise
        self.ok_calls += 1

        model_name = kwargs["model"]

        # The response names the model that actually answered. Behind a
        # router (openrouter/free) that is the only place the true author
        # appears, and one audit's calls may be served by several.
        served = getattr(response, "model", None)
        if served:
            self.served_models.add(str(served))

        # Track token usage
        if response.usage:
            prompt_tokens = response.usage.prompt_tokens
            completion_tokens = response.usage.completion_tokens

            self.prompt_tokens[model_name] += prompt_tokens
            self.completion_tokens[model_name] += completion_tokens

            # Calculate and track cost
            cost = self._calculate_cost(model_name, prompt_tokens, completion_tokens)
            self.total_cost[model_name] += cost

        return response

    def get_usage_summary(self) -> dict[str, dict]:
        """
        Get a summary of token usage and costs by model as well as aggregated
        totals.
        """
        return {
            "by-model": {
                model: {
                    "prompt_tokens": f"{self.prompt_tokens[model]:,}",
                    "completion_tokens": f"{self.completion_tokens[model]:,}",
                    "total_tokens": f"{self.prompt_tokens[model] + self.completion_tokens[model]:,}",
                    "total_cost": (
                        f"${self.total_cost[model]:.6f}"
                        if self.pricing.get(model)
                        else "Unknown"
                    ),
                }
                for model in self.prompt_tokens
            },
            "total": {
                "prompt_tokens": f"{sum(self.prompt_tokens.values()):,}",
                "completion_tokens": f"{sum(self.completion_tokens.values()):,}",
                "total_tokens": f"{sum(
                        list(self.prompt_tokens.values())
                        + list(self.completion_tokens.values())):,}",
                "total_cost": (
                    f"${sum(self.total_cost.values()):.6f}"
                    if any(k in self.pricing for k in self.total_cost.keys())
                    else "Unknown"
                ),
            },
        }


