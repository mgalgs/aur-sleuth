            tui.update_status("Generating lines...")
            # Generate lines of increasing length to trigger wrapping
            for i in range(1, 16):
                prefix = f"Log {i:02d}: "
                body = ("-" * (i * 6))  # grows over time, causes wraps
                # Alternate statuses to exercise color and icons
                status = [
                    SafeStatus.SAFE,
                    SafeStatus.UNSAFE,
