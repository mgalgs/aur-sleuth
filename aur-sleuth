def setup_logging():
    tmpdir_parent = Path(tempfile.gettempdir()) / "aur-sleuth"
    os.makedirs(tmpdir_parent, exist_ok=True)

    log_file = tmpdir_parent / "aur-sleuth-debug.log"

    # The pipeline starts several audits at once and they share this path:
    # between one process seeing the file and removing it, another has. A
    # missing file is the state wanted here, not an error -- one run lost
    # four audits to this before it was tolerated.
    try:
        os.remove(log_file)
    except FileNotFoundError:
        pass

    # Set up file logging
    logging.basicConfig(
        level=logging.DEBUG,
        format="%(asctime)s - %(name)s - %(threadName)s - %(message)s",
        filename=log_file,
        filemode="a",
    )

    # Add console handler for stdout
    console_handler = logging.StreamHandler(sys.stdout)
    console_handler.setLevel(logging.INFO)
    console_handler.setFormatter(
        logging.Formatter("%(asctime)s - %(name)s - %(threadName)s - %(message)s")
    )
    logging.getLogger().addHandler(console_handler)

    # Disable noisy logs from openai library (and deps) that were messing up the TUI
    logging.getLogger("httpx").setLevel(logging.ERROR)

