def _match_language(code: str) -> str:
    """Map a locale code to a table language, or '' when nothing matches.

    Priority, per the requirement for regional variants: the exact code
    ("zh_CN") first, then the bare language ("zh"), then any other key for
    that language ("zh_TW", "zh_HK", ...), else no match. Case-insensitive
    ("zh_cn" and "zh_CN" both resolve), so a locale string works as-is.
    """
    code = (code or "").strip().replace("-", "_")
    if not code:
        return ""
    for c in (code, code.lower()):
        if c in _TRANSLATIONS:
            return c
    lang = code.lower().split("_", 1)[0]
    if lang in _TRANSLATIONS:
        return lang
    for key in _TRANSLATIONS:
        if key.split("_", 1)[0].lower() == lang:
            return key
    return ""


def current_language() -> str:
    """The language of the console, 'en' when nothing selects another.

    The system locale decides, so no configuration is needed for the common
    case: LC_ALL, then LC_MESSAGES, then LANG (POSIX precedence), each
    matched against the table with _match_language's priority -- LANG=zh_CN.UTF-8
    selects zh today and a finer zh_CN table entry if one is added later.
    AUR_SLEUTH_LANG overrides the locale explicitly; anything unmatched
    falls back to English rather than guessing.
    """
    explicit = os.environ.get("AUR_SLEUTH_LANG", "").strip()
    if explicit:
        return _match_language(explicit) or "en"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        loc = os.environ.get(var, "").strip()
        if loc:
            matched = _match_language(loc.split(".", 1)[0])
            if matched:
                return matched
    return "en"


def _(msgid: str) -> str:
    """Translate a console message, or return it unchanged.

    Keys are the English strings with {placeholders}; callers apply .format()
    after lookup. The report_msg= a TUI method receives is the untranslated
    English string, so the published report never depends on the locale.
    """
    return _TRANSLATIONS.get(current_language(), {}).get(msgid, msgid)


# --- verdict prose translation (display only) --------------------------------
#
# The audit call writes <summary>/<details> in the model's language, which is
# English. A Chinese speaker cannot read the findings, so -- when the console
# language is not English -- a SEPARATE narrow call translates the prose after
# the audit, purely for display. This is the "summary" surface the user reads,
# and it is deliberately not part of the audit prompt: the review prompt, the
# decision, the report file, and the second look are all untouched, and the
# translation cannot change a verdict or leak into anything published.
#
# Only verdicts worth reading are sent: SAFE verdicts say nothing the reader
# needs (their prose is skipped), so a typical clean package costs nothing.
# Everything here is best effort: any failure keeps the English text.
VERDICT_TRANSLATIONS: Dict[int, Tuple[str, str]] = {}

_TRANSLATE_ITEMS_MAX = 40
_TRANSLATE_DETAIL_CHARS = 4000

# The translator's system instruction is per-language content and lives in
# _TRANSLATIONS under the "_verdict_translator" key (see the entry's comment);
# translate_verdicts_batch() looks it up for the active language. The format
# prompt below is protocol: the <translations>/<item>/<summary> tags are what
# _parse_verdict_translations() parses, so they stay in code like the audit's
# own XML contract.
_VERDICT_TRANSLATOR_PROMPT = """Translate each item below.

<items>
{item_xml}
</items>

Reply with exactly one block, one <item> per input item, with the same index values:

<translations>
<item index="0"><summary>译文</summary><details>译文</details></item>
</translations>"""


def verdict_translation_enabled() -> bool:
    """Translate model-written verdict prose for the console (display only).

    OFF by default: it costs a second LLM call per flagged verdict, so it is
    opt-in. AUR_SLEUTH_TRANSLATE_VERDICTS=true (environment or config file)
    turns it on; any other value leaves it off. Never in dry-run mode, which
    builds prompts without calling a model. The translation is a second,
    narrow call that reads only the verdict text, so it cannot influence the
    audit decision; a language without a translator instruction in the table
    simply gets none (the batch checks, and skips rather than guessing).
    """
    switch = os.environ.get("AUR_SLEUTH_TRANSLATE_VERDICTS", "").strip().lower()
    if switch not in ("1", "true", "yes", "on"):
        return False
    return current_language() != "en" and not dry_run_enabled()


def _parse_verdict_translations(reply: str) -> Dict[int, Tuple[str, str]]:
    """Parse the translator's <translations> block into {index: (summary, details)}.

    Returns {} on any malformed reply; the caller keeps the English text.
    """
    reply = strip_markdown_fences(reply or "")
    match = re.search(r"<translations>(.*)</translations>", reply, re.S)
    if not match:
        return {}
    try:
        root = ET.fromstring(f"<root>{match.group(1)}</root>")
    except ET.ParseError:
        return {}
    out = {}
    for item in root.findall("item"):
        idx = item.get("index")
        if idx is None or not idx.isdigit():
            continue
        out[int(idx)] = (item.findtext("summary") or "", item.findtext("details") or "")
    return out


def translate_verdicts_batch(tui: "ConsoleUI", llm_client: "LLMClient", audit_results: "List[AuditResult]", package_name: str) -> None:
    """One call translating every non-SAFE verdict's prose into the console
    language; stores the result in VERDICT_TRANSLATIONS keyed by id(result).

    A no-op when translation is off, nothing needs translating, or the call
    fails -- the display then falls back to the English text. The translation
    is display-only: it reads the verdict text and writes nothing back to the
    results or the report. Failures are loud (a warning in the console log),
    so a missing translation is never silent.
    """
    results = [
        r for r in (audit_results or [])
        if r.status in (SafeStatus.UNSAFE, SafeStatus.INCONCLUSIVE)
        and (r.summary or r.details)
    ]
    if not results or not verdict_translation_enabled():
        return
    # The translator's instruction is per-language content (see the table
    # entry's comment). A language without one gets no translation rather
    # than a prompt that names the wrong target language.
    translator_system = _TRANSLATIONS.get(current_language(), {}).get("_verdict_translator")
    if not translator_system:
        logger.warning(
            _("No translator instruction for {language}; verdicts stay English").format(
                language=current_language()
            )
        )
        return
    # The spinner still reads "reviewing" otherwise; say what is happening.
    tui.update_status(
        _("Translating verdicts for display..."),
        report_msg="Translating verdicts for display...",
    )
    results = results[:_TRANSLATE_ITEMS_MAX]
    items = []
    for i, r in enumerate(results):
        details = (r.details or "")[:_TRANSLATE_DETAIL_CHARS]
        items.append(
            f'<item index="{i}"><summary>{sanitize_xml_string(r.summary or "")}</summary>'
            f"<details>{sanitize_xml_string(details)}</details></item>"
        )
    # A translation call wants determinism and brevity, not reasoning; the
    # audit's own temperature and effort stay untouched.
    params = get_llm_params_from_env()
    llm = LLM(
        limit_tokens=SESSION_AUDIT_LIMIT_TOKENS,
        llm_client=llm_client,
        model=params.model,
        system_prompt=translator_system,
        temperature=0.0,
        reasoning_effort="low",
        stage="translate",
        label=package_name,
    )
    try:
        reply = llm.chat(_VERDICT_TRANSLATOR_PROMPT.format(item_xml="\n".join(items)))
    except Exception as e:
        logger.warning(
            _("Verdict translation failed for {package_name}; keeping English: {error}").format(
                package_name=package_name, error=describe_error(e)
            )
        )
        return
    parsed = _parse_verdict_translations(reply)
    if not parsed:
        logger.warning(
            _("Verdict translation for {package_name} did not parse; keeping English").format(
                package_name=package_name
            )
        )
        return
    VERDICT_TRANSLATIONS.update(
        {id(results[i]): parsed[i] for i in parsed if 0 <= i < len(results)}
    )

