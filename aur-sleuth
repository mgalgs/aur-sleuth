_MODEL_ID_RE = re.compile(r"^[A-Za-z0-9._/:-]+$")
_MODEL_ALIAS_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]{0,39}$")


def parse_model_aliases(value: str) -> Dict[str, str]:
    """Parse ``name=model;name=model`` into a validated alias mapping.

    Semicolons separate entries because commas already separate model seats.
    Aliases are opt-in references written as ``@name``; a concrete provider
    model id is never reinterpreted through this mapping.
    """
    aliases: Dict[str, str] = {}
    if not value:
        return aliases
    for entry in value.split(";"):
        if entry.count("=") != 1:
            raise ValueError("model aliases must use name=model entries separated by semicolons")
        name, model = entry.split("=", 1)
        if not _MODEL_ALIAS_RE.fullmatch(name):
            raise ValueError(f"invalid model alias name: {name!r}")
        if not _MODEL_ID_RE.fullmatch(model):
            raise ValueError(f"invalid model id for alias {name!r}: {model!r}")
        if name in aliases:
            raise ValueError(f"duplicate model alias: {name}")
        aliases[name] = model
    return aliases


def resolve_model_reference(value: str, aliases: Dict[str, str]) -> Tuple[str, str]:
    """Return (concrete model id, requested alias or empty string)."""
    if not value.startswith("@"):
        if not _MODEL_ID_RE.fullmatch(value):
            raise ValueError(f"invalid model id: {value!r}")
        return value, ""
    name = value[1:]
    if name not in aliases:
        raise ValueError(f"unknown model alias: @{name}")
    return aliases[name], name

